        aimBtn.Visible = wantBtn
        local on = aimActive()
        aimBtn.BackgroundColor3 = on and Color3.fromRGB(40,120,60) or Color3.fromRGB(28,28,32)
        if not on then return end
        local _, predicted = getClosestTarget(); if not predicted then return end
        local cam = workspace.CurrentCamera
        if UserInputService.MouseEnabled and mousemoverel then
            local sp = cam:WorldToViewportPoint(predicted); if sp.Z <= 0 then return end
            local move = Vector2.new(sp.X, sp.Y) - getAimOrigin()
            if move.Magnitude > 0.5 then pcall(mousemoverel, move.X, move.Y) end
        else cam.CFrame = CFrame.new(cam.CFrame.Position, predicted) end
    end)
    getgenv().ZkxAimbot = {
        State = Aim,
        Cleanup = function()
            if conn    then conn:Disconnect()    end
            if kbBegan then kbBegan:Disconnect() end
            if kbEnded then kbEnded:Disconnect() end
            if fovGui    then fovGui:Destroy()    end
            if aimBtnGui then aimBtnGui:Destroy() end
        end,
    }
end


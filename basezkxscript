local DynamicLists = { Wrap = {"WIP [Equip in inventory]"}, Charm = {"WIP [Equip in inventory]"}, Finisher = {"WIP"} }
local function buildDynamicLists()
    if not CosmeticLibrary or not CosmeticLibrary.Cosmetics then return end
    for name, data in pairs(CosmeticLibrary.Cosmetics) do
        if type(data) == "table" and data.Type and name ~= "Default" then
            local t = data.Type:lower()
            if t:find("wrap", 1, true) then
                if not table.find(DynamicLists.Wrap, name) then table.insert(DynamicLists.Wrap, name) end
            elseif t:find("charm", 1, true) then
                if not table.find(DynamicLists.Charm, name) then table.insert(DynamicLists.Charm, name) end
            elseif t:find("finish", 1, true) or t:find("kill", 1, true) then
                if not table.find(DynamicLists.Finisher, name) then table.insert(DynamicLists.Finisher, name) end
            end
        end
    end
    for _, list in pairs(DynamicLists) do
        table.sort(list, function(a, b) return a:lower() < b:lower() end)
    end
end

local function getOptions(weapon, type)
    if type == "Skin"     then return SkinLists[weapon] or {"Default"}
    elseif type == "Wrap"     then return DynamicLists.Wrap
    elseif type == "Charm"    then return DynamicLists.Charm
    elseif type == "Finisher" then return DynamicLists.Finisher end
    return {"Default"}
end


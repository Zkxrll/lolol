    elseif type(img) == "string" then
        if img:match("^%d+$") then img = "rbxassetid://"..img
        elseif not img:find("://",1,true) then img = "rbxassetid://"..img end
    else previewImage.Image = ""; return end
    previewImage.Image = img
end

function UpdateCosmeticDropdowns()
    if not Options or not Options.Cosm_Weapon then return end
    if Options.Cosm_Skin then
        Options.Cosm_Skin:SetValues(getOptions(SelectedWeapon, "Skin"))
        Options.Cosm_Skin:SetValue(EquippedSkins[SelectedWeapon] or "Default")
    end
    if Options.Cosm_Wrap     then pcall(function() Options.Cosm_Wrap:SetValue(EquippedSkins[SelectedWeapon.."_wrap"]     or "Default") end) end
    if Options.Cosm_Charm    then pcall(function() Options.Cosm_Charm:SetValue(EquippedSkins[SelectedWeapon.."_charm"]    or "Default") end) end
    if Options.Cosm_Finisher then pcall(function() Options.Cosm_Finisher:SetValue(EquippedSkins[SelectedWeapon.."_finisher"] or "Default") end) end
    UpdatePreview()
end


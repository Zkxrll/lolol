    local useItemRemote      = fighterRemotes and fighterRemotes:FindFirstChild("UseItem") -- NEW

    local old
    old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local m = getnamecallmethod()
        if m == "Kick" and self == LocalPlayer then return nil end
        if m == "FireServer" and typeof(self) == "Instance" then
            local args = {...}

            -- NEW: track which weapon was just used so finisher hook knows
            if useItemRemote and self == useItemRemote then
                local objectID = args[1]
                pcall(function()
                    if not FighterController then return end
                    local fighter = FighterController:GetFighter(LocalPlayer)

                        end
                    end
                end)
            end

            if equipRemote and self == equipRemote then
                local wn, ct, cn, options = args[1], args[2], args[3], args[4] or {}
                if cn and cn ~= "None" and cn ~= "" then
                    local inv = DataController:Get("CosmeticInventory")
                    if inv and rawget(inv, cn) then return old(self, ...) end
                end
                equipped = equipped or {}  -- safety
                if not wn then return old(self, ...) end
                if not cn or cn == "None" or cn == "" then
                    if EquippedSkins[wn .. "_" .. tostring(ct):lower()] then
                        applyEquippedSkin(wn .. "_" .. tostring(ct):lower(), nil)
                    end
                else
                    local cosType = tostring(ct)
                    local key = cosType == "Skin" and wn or (wn .. "_" .. cosType:lower())
                    applyEquippedSkin(key, cn)
                end
                task.defer(function()
                    pcall(function() DataController.CurrentData:Replicate("WeaponInventory") end)
                    task.wait(0.2)
                    saveMasterData()
                end)
                return
            end

            if favoriteRemote and self == favoriteRemote then
                local a1, a2, a3 = args[1], args[2], args[3]
                if CosmeticLibrary and CosmeticLibrary.Cosmetics then
                    local cosmetic = CosmeticLibrary.Cosmetics[a2]
                    if cosmetic then

-- Preview image injection
do
    local probe = sections.CosmRight:AddLabel("__probe__")
    local probeInst = nil
    if typeof(probe) == "Instance" then probeInst = probe
    elseif type(probe) == "table" then
        for _, k in ipairs({"Instance","Label","Frame","Object","TextLabel"}) do
            if typeof(probe[k]) == "Instance" then probeInst = probe[k]; break end
        end
    end
    local container = probeInst and probeInst.Parent or nil
    if probeInst then pcall(function() probeInst:Destroy() end) end
    if type(probe) == "table" and type(probe.Destroy) == "function" then pcall(function() probe:Destroy() end) end
    if container and typeof(container) == "Instance" then
        previewImage = Instance.new("ImageLabel")
        previewImage.Name="SkinPreview"; previewImage.Size=UDim2.new(1,-8,0,170)
        previewImage.BackgroundColor3=Color3.fromRGB(16,16,20); previewImage.BackgroundTransparency=0
        previewImage.BorderSizePixel=0; previewImage.Image=""; previewImage.ScaleType=Enum.ScaleType.Fit
        previewImage.LayoutOrder=9999; previewImage.Parent=container
        Instance.new("UICorner",previewImage).CornerRadius=UDim.new(0,6)
        local pad=Instance.new("UIPadding",previewImage)
        pad.PaddingLeft=UDim.new(0,4); pad.PaddingBottom=UDim.new(0,4)
    else
        previewImage=nil
        pcall(function() sections.CosmRight:AddLabel("Preview unavailable") end)
    end
    task.delay(6, function() pcall(UpdatePreview) end)
end


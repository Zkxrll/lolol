    end)
    aimBtn.InputEnded:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.Touch and i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if Aim.Mode == "Hold" then Aim.Holding = false end
    end)
    local MOUSE_NAMES = {}
    for _, n in ipairs({"MouseButton1","MouseButton2","MouseButton3","MouseButton4","MouseButton5"}) do
        local ok, e = pcall(function() return Enum.UserInputType[n] end)
        if ok and e then MOUSE_NAMES[e] = n end
    end
    local function inputIdentity(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Unknown then return input.KeyCode, input.KeyCode.Name end
        elseif MOUSE_NAMES[input.UserInputType] then return input.UserInputType, MOUSE_NAMES[input.UserInputType] end
        return nil
    end
    local function matchesBind(input) local id = inputIdentity(input); return id ~= nil and id == Aim.Key end
    local kbBegan = UserInputService.InputBegan:Connect(function(input, gpe)
        if Aim.Listening then
            if os.clock() - Aim.ListenStart < 0.2 then return end
            local id, name = inputIdentity(input)
            if id then Aim.Key, Aim.KeyName, Aim.Listening = id, name, false
                if Aim.OnRebind then pcall(Aim.OnRebind, name) end end
            return
        end
        if gpe and input.UserInputType == Enum.UserInputType.Keyboard then return end
        if not matchesBind(input) then return end
        if Aim.Mode == "Hold" then Aim.Holding = true elseif Aim.Mode == "Toggle" then Aim.Toggled = not Aim.Toggled end
    end)
    local kbEnded = UserInputService.InputEnded:Connect(function(input)
        if not matchesBind(input) then return end
        if Aim.Mode == "Hold" then Aim.Holding = false end
